using FluentAssertions;
using Indt.Teste.PropostaService.Domain.Entities;
using Indt.Teste.PropostaService.Domain.Enums;
using Indt.Teste.PropostaService.Domain.Exceptions;

namespace Indt.Teste.PropostaService.UnitTests.Domain.Entities;

public class PropostaTests
{
    private const string NumeroProposta = "PROP-2024-001";
    private static readonly Guid ClienteId = Guid.NewGuid();
    private static readonly Guid SeguradoraId = Guid.NewGuid();
    private static readonly Guid CorretorId = Guid.NewGuid();
    private static readonly Guid ProdutoSeguroId = Guid.NewGuid();
    private const decimal Valor = 1000m;

    [Fact]
    public void Proposta_Construtor_DeveInitializarComValoresCorretos()
    {
        // Act
        var proposta = new Proposta(
            NumeroProposta,
            ClienteId,
            SeguradoraId,
            CorretorId,
            ProdutoSeguroId,
            Valor
        );

        // Assert
        proposta.Should().NotBeNull();
        proposta.Id.Should().NotBe(Guid.Empty);
        proposta.NumeroProposta.Should().Be(NumeroProposta);
        proposta.ClienteId.Should().Be(ClienteId);
        proposta.SeguradoraId.Should().Be(SeguradoraId);
        proposta.CorretorId.Should().Be(CorretorId);
        proposta.ProdutoSeguroId.Should().Be(ProdutoSeguroId);
        proposta.Valor.Should().Be(Valor);
        proposta.Status.Should().Be(StatusProposta.EmAnalise);
        proposta.DataCriacao.Should().BeCloseTo(DateTime.UtcNow, TimeSpan.FromSeconds(1));
    }

    [Fact]
    public void Proposta_Construtor_DeveGerarIdUnico()
    {
        // Act
        var proposta1 = new Proposta(NumeroProposta, ClienteId, SeguradoraId, CorretorId, ProdutoSeguroId, Valor);
        var proposta2 = new Proposta(NumeroProposta, ClienteId, SeguradoraId, CorretorId, ProdutoSeguroId, Valor);

        // Assert
        proposta1.Id.Should().NotBe(proposta2.Id);
    }

    [Fact]
    public void Proposta_Construtor_DeveInitializarComStatusEmAnalise()
    {
        // Act
        var proposta = new Proposta(NumeroProposta, ClienteId, SeguradoraId, CorretorId, ProdutoSeguroId, Valor);

        // Assert
        proposta.Status.Should().Be(StatusProposta.EmAnalise);
    }

    [Fact]
    public void Proposta_Aprovar_DeveAlterarStatusParaAprovada()
    {
        // Arrange
        var proposta = new Proposta(NumeroProposta, ClienteId, SeguradoraId, CorretorId, ProdutoSeguroId, Valor);

        // Act
        proposta.Aprovar();

        // Assert
        proposta.Status.Should().Be(StatusProposta.Aprovada);
    }

    [Fact]
    public void Proposta_Rejeitar_DeveAlterarStatusParaRejeitada()
    {
        // Arrange
        var proposta = new Proposta(NumeroProposta, ClienteId, SeguradoraId, CorretorId, ProdutoSeguroId, Valor);

        // Act
        proposta.Rejeitar();

        // Assert
        proposta.Status.Should().Be(StatusProposta.Rejeitada);
    }

    [Fact]
    public void Proposta_Aprovar_DeApartirDeStatusAprovada_DeveLancarExcecao()
    {
        // Arrange
        var proposta = new Proposta(NumeroProposta, ClienteId, SeguradoraId, CorretorId, ProdutoSeguroId, Valor);
        proposta.Aprovar();

        // Act & Assert
        var action = () => proposta.Aprovar();
        action.Should().Throw<TransicaoStatusException>()
            .WithMessage("*Transição de status inválida*");
    }

    [Fact]
    public void Proposta_Rejeitar_DeApartirDeStatusRejeitada_DeveLancarExcecao()
    {
        // Arrange
        var proposta = new Proposta(NumeroProposta, ClienteId, SeguradoraId, CorretorId, ProdutoSeguroId, Valor);
        proposta.Rejeitar();

        // Act & Assert
        var action = () => proposta.Rejeitar();
        action.Should().Throw<TransicaoStatusException>()
            .WithMessage("*Transição de status inválida*");
    }

    [Fact]
    public void Proposta_AprovarDepoisRejeitar_DeveLancarExcecao()
    {
        // Arrange
        var proposta = new Proposta(NumeroProposta, ClienteId, SeguradoraId, CorretorId, ProdutoSeguroId, Valor);
        proposta.Aprovar();

        // Act & Assert
        var action = () => proposta.Rejeitar();
        action.Should().Throw<TransicaoStatusException>()
            .WithMessage("*Transição de status inválida*");
    }

    [Fact]
    public void Proposta_RejeitarDepoisAprovar_DeveLancarExcecao()
    {
        // Arrange
        var proposta = new Proposta(NumeroProposta, ClienteId, SeguradoraId, CorretorId, ProdutoSeguroId, Valor);
        proposta.Rejeitar();

        // Act & Assert
        var action = () => proposta.Aprovar();
        action.Should().Throw<TransicaoStatusException>()
            .WithMessage("*Transição de status inválida*");
    }

    [Theory]
    [InlineData(0)]
    [InlineData(1)]
    [InlineData(999.99)]
    [InlineData(999999.99)]
    public void Proposta_ComValorDiferente_DeveSerCriadaComSucesso(decimal valor)
    {
        // Act
        var proposta = new Proposta(NumeroProposta, ClienteId, SeguradoraId, CorretorId, ProdutoSeguroId, valor);

        // Assert
        proposta.Valor.Should().Be(valor);
    }

    [Theory]
    [InlineData("PROP-001")]
    [InlineData("PROP-2024-12345")]
    [InlineData("123456")]
    public void Proposta_ComNumeroDiferente_DeveSerCriadaComSucesso(string numero)
    {
        // Act
        var proposta = new Proposta(numero, ClienteId, SeguradoraId, CorretorId, ProdutoSeguroId, Valor);

        // Assert
        proposta.NumeroProposta.Should().Be(numero);
    }

    [Fact]
    public void Proposta_TodasAsPropriedadesPrivadas_NaoDevemSerAlteradasDiretamente()
    {
        // Arrange
        var proposta = new Proposta(NumeroProposta, ClienteId, SeguradoraId, CorretorId, ProdutoSeguroId, Valor);
        var idOriginal = proposta.Id;

        // Act & Assert - Verificar que as propriedades não possuem setters públicos
        var properties = typeof(Proposta).GetProperties();
        var publicSetters = properties.Where(p => p.SetMethod?.IsPublic == true);

        publicSetters.Should().BeEmpty();
    }

    [Fact]
    public void Proposta_StatusProperty_ApenasLeitura()
    {
        // Arrange
        var proposta = new Proposta(NumeroProposta, ClienteId, SeguradoraId, CorretorId, ProdutoSeguroId, Valor);

        // Act & Assert
        var statusProperty = typeof(Proposta).GetProperty(nameof(Proposta.Status));
        statusProperty?.SetMethod?.IsPublic.Should().BeFalse();
    }
}
