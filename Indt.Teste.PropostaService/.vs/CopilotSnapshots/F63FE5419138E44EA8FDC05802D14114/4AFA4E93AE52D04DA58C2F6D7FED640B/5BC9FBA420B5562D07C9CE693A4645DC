using FluentAssertions;
using Indt.Teste.PropostaService.Domain.Entities;
using Indt.Teste.PropostaService.Domain.Enums;
using Indt.Teste.PropostaService.Domain.Exceptions;
using Indt.Teste.PropostaService.UnitTests.TestHelpers;

namespace Indt.Teste.PropostaService.UnitTests.Domain.Entities;

public class PropostaBusinessRulesTests
{
    [Fact]
    public void Proposta_NovaPropostaDeveTerStatusEmAnalise()
    {
        // Arrange & Act
        var proposta = new PropostaTestBuilder().Build();

        // Assert
        proposta.Status.Should().Be(StatusProposta.EmAnalise);
    }

    [Fact]
    public void Proposta_AprovarPropostaEmAnalise_DeveAprovar()
    {
        // Arrange
        var proposta = new PropostaTestBuilder().Build();

        // Act
        proposta.Aprovar();

        // Assert
        proposta.Status.Should().Be(StatusProposta.Aprovada);
    }

    [Fact]
    public void Proposta_RejeitarPropostaEmAnalise_DeveRejeitar()
    {
        // Arrange
        var proposta = new PropostaTestBuilder().Build();

        // Act
        proposta.Rejeitar();

        // Assert
        proposta.Status.Should().Be(StatusProposta.Rejeitada);
    }

    [Fact]
    public void Proposta_AprovarPropostaAprovada_DeveLancarException()
    {
        // Arrange
        var proposta = new PropostaTestBuilder().Build();
        proposta.Aprovar();

        // Act & Assert
        var action = () => proposta.Aprovar();
        action.Should().Throw<TransicaoStatusException>();
    }

    [Fact]
    public void Proposta_RejeitarPropostaRejeitada_DeveLancarException()
    {
        // Arrange
        var proposta = new PropostaTestBuilder().Build();
        proposta.Rejeitar();

        // Act & Assert
        var action = () => proposta.Rejeitar();
        action.Should().Throw<TransicaoStatusException>();
    }

    [Fact]
    public void Proposta_AprovarDepoisRejeitar_DeveLancarException()
    {
        // Arrange
        var proposta = new PropostaTestBuilder().Build();
        proposta.Rejeitar();

        // Act & Assert
        var action = () => proposta.Aprovar();
        action.Should().Throw<TransicaoStatusException>();
    }

    [Fact]
    public void Proposta_RejeitarDepoisAprovar_DeveLancarException()
    {
        // Arrange
        var proposta = new PropostaTestBuilder().Build();
        proposta.Aprovar();

        // Act & Assert
        var action = () => proposta.Rejeitar();
        action.Should().Throw<TransicaoStatusException>();
    }

    [Fact]
    public void Proposta_PropostasComNumeroDiferente_SaoEntidadesDistintas()
    {
        // Arrange & Act
        var proposta1 = new PropostaTestBuilder()
            .ComNumeroProposta("PROP-001")
            .Build();

        var proposta2 = new PropostaTestBuilder()
            .ComNumeroProposta("PROP-002")
            .Build();

        // Assert
        proposta1.Id.Should().NotBe(proposta2.Id);
        proposta1.NumeroProposta.Should().NotBe(proposta2.NumeroProposta);
    }

    [Fact]
    public void Proposta_PropostasComClientesDiferentes_SaoEntidadesDistintas()
    {
        // Arrange
        var clienteId1 = Guid.NewGuid();
        var clienteId2 = Guid.NewGuid();

        // Act
        var proposta1 = new PropostaTestBuilder().ComClienteId(clienteId1).Build();
        var proposta2 = new PropostaTestBuilder().ComClienteId(clienteId2).Build();

        // Assert
        proposta1.ClienteId.Should().NotBe(proposta2.ClienteId);
    }

    [Fact]
    public void Proposta_PropostasComValoresDiferentes_SãoArmazenadas()
    {
        // Arrange & Act
        var proposta1 = new PropostaTestBuilder().ComValor(500m).Build();
        var proposta2 = new PropostaTestBuilder().ComValor(1500m).Build();

        // Assert
        proposta1.Valor.Should().Be(500m);
        proposta2.Valor.Should().Be(1500m);
    }

    [Fact]
    public void Proposta_DataCriacao_DeveSerRegistradaEmUtc()
    {
        // Arrange
        var antesdaCriacao = DateTime.UtcNow;

        // Act
        var proposta = new PropostaTestBuilder().Build();

        // Assert
        proposta.DataCriacao.Should().BeAfter(antesdaCriacao.AddSeconds(-1));
        proposta.DataCriacao.Should().BeBefore(DateTime.UtcNow.AddSeconds(1));
        proposta.DataCriacao.Kind.Should().Be(DateTimeKind.Utc);
    }

    [Fact]
    public void Proposta_ApenasPropostaEmAnalise_PodeTransicionarDeStatus()
    {
        // Arrange
        var proposta = new PropostaTestBuilder().Build();

        // Act & Assert - Primeira transição OK
        proposta.Aprovar();
        proposta.Status.Should().Be(StatusProposta.Aprovada);

        // Act & Assert - Próximas transições devem lançar exceção
        proposta.Invoking(p => p.Rejeitar())
            .Should().Throw<TransicaoStatusException>();

        proposta.Invoking(p => p.Aprovar())
            .Should().Throw<TransicaoStatusException>();
    }
}
