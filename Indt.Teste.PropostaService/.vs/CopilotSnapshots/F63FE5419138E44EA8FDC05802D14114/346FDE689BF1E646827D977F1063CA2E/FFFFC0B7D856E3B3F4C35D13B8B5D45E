using FluentAssertions;
using Indt.Teste.PropostaService.Application.Common;
using Indt.Teste.PropostaService.Application.Models;
using Indt.Teste.PropostaService.Application.UseCases;
using Moq;

namespace Indt.Teste.PropostaService.UnitTests.Application.UseCases;

public class GetPropostaByIdUseCaseTests
{
    private readonly Mock<IPropostaRepository> _repositoryMock;
    private readonly GetPropostaByIdUseCase _useCase;

    public GetPropostaByIdUseCaseTests()
    {
        _repositoryMock = new Mock<IPropostaRepository>();
        _useCase = new GetPropostaByIdUseCase(_repositoryMock.Object);
    }

    [Fact]
    public async Task ExecuteAsync_ComPropostaExistente_DeveRetornarSucesso()
    {
        // Arrange
        var propostaId = Guid.NewGuid();
        var propostaDetails = new PropostaDetailsReadModel
        {
            Id = propostaId,
            NumeroProposta = "PROP-001",
            ClienteNome = "Cliente Teste",
            SeguradoraNome = "Seguradora Teste",
            CorretorNome = "Corretor Teste",
            ProdutoSeguroNome = "Produto Teste",
            Valor = 1000m,
            Status = "EmAnalise",
            DataCriacao = DateTime.UtcNow
        };

        _repositoryMock
            .Setup(r => r.GetDetailsByIdAsync(propostaId))
            .ReturnsAsync(propostaDetails);

        // Act
        var result = await _useCase.ExecuteAsync(propostaId);

        // Assert
        result.IsSuccess.Should().BeTrue();
        result.Value.Should().NotBeNull();
        result.Value!.Id.Should().Be(propostaId);
        result.Value.NumeroProposta.Should().Be("PROP-001");
        _repositoryMock.Verify(r => r.GetDetailsByIdAsync(propostaId), Times.Once);
    }

    [Fact]
    public async Task ExecuteAsync_ComPropostaNaoExistente_DeveRetornarFailure()
    {
        // Arrange
        var propostaId = Guid.NewGuid();

        _repositoryMock
            .Setup(r => r.GetDetailsByIdAsync(propostaId))
            .ReturnsAsync((PropostaDetailsReadModel?)null);

        // Act
        var result = await _useCase.ExecuteAsync(propostaId);

        // Assert
        result.IsFailure.Should().BeTrue();
        result.Error.Should().Contain("Proposta não encontrada");
        result.Value.Should().BeNull();
    }

    [Fact]
    public async Task ExecuteAsync_DeveRetornarPropostaComTodosOsDados()
    {
        // Arrange
        var propostaId = Guid.NewGuid();
        var dataCriacao = DateTime.UtcNow;
        var propostaDetails = new PropostaDetailsReadModel
        {
            Id = propostaId,
            NumeroProposta = "PROP-2024-001",
            ClienteNome = "Fulano Silva",
            SeguradoraNome = "Seguros ABC",
            CorretorNome = "Corretor XYZ",
            ProdutoSeguroNome = "Seguro Vida",
            Valor = 5000m,
            Status = "Aprovada",
            DataCriacao = dataCriacao
        };

        _repositoryMock
            .Setup(r => r.GetDetailsByIdAsync(propostaId))
            .ReturnsAsync(propostaDetails);

        // Act
        var result = await _useCase.ExecuteAsync(propostaId);

        // Assert
        result.IsSuccess.Should().BeTrue();
        result.Value!.ClienteNome.Should().Be("Fulano Silva");
        result.Value.SeguradoraNome.Should().Be("Seguros ABC");
        result.Value.CorretorNome.Should().Be("Corretor XYZ");
        result.Value.ProdutoSeguroNome.Should().Be("Seguro Vida");
        result.Value.Valor.Should().Be(5000m);
        result.Value.Status.Should().Be("Aprovada");
        result.Value.DataCriacao.Should().Be(dataCriacao);
    }

    [Fact]
    public async Task ExecuteAsync_DeveCallRepositoryComIdCorreto()
    {
        // Arrange
        var propostaId = Guid.NewGuid();
        var propostaDetails = new PropostaDetailsReadModel { Id = propostaId };

        _repositoryMock
            .Setup(r => r.GetDetailsByIdAsync(It.IsAny<Guid>()))
            .ReturnsAsync(propostaDetails);

        // Act
        await _useCase.ExecuteAsync(propostaId);

        // Assert
        _repositoryMock.Verify(r => r.GetDetailsByIdAsync(propostaId), Times.Once);
        _repositoryMock.VerifyNoOtherCalls();
    }

    [Theory]
    [InlineData("EmAnalise")]
    [InlineData("Aprovada")]
    [InlineData("Rejeitada")]
    public async Task ExecuteAsync_ComDiferentesStatus_DeveRetornarSucesso(string status)
    {
        // Arrange
        var propostaId = Guid.NewGuid();
        var propostaDetails = new PropostaDetailsReadModel
        {
            Id = propostaId,
            Status = status
        };

        _repositoryMock
            .Setup(r => r.GetDetailsByIdAsync(propostaId))
            .ReturnsAsync(propostaDetails);

        // Act
        var result = await _useCase.ExecuteAsync(propostaId);

        // Assert
        result.IsSuccess.Should().BeTrue();
        result.Value!.Status.Should().Be(status);
    }
}
